# Server Configuration
PROJECT_NAME="SentinelAI"
API_V1_STR="/api/v1"
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Defaults to SQLite locally if PostgreSQL is unavailable
DATABASE_URL="sqlite+aiosqlite:///./sentinelai.db"
# Production Postgres:
# DATABASE_URL="postgresql+asyncpg://sentinelai:sentinelai_pass@localhost:5432/sentinelai_db"

# Redis Configuration (Optional)
REDIS_URL="redis://localhost:6379/0"

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Next.js API URL
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
